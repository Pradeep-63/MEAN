{
  "openapi": "3.0.0",
  "info": {
    "title": "My API",
    "version": "1.0.0",
    "description": "API Documentation with JWT Bearer Authentication"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description":"local server"
    },
    {
      "url": "https://schoolmanagement:3000/api/v1",
      "description":"production server"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "description": "User login endpoint.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "any"
                  },
                  "password": {
                    "type": "string",
                    "example": "any"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        },
        "security": [] 
      }
    },
    "/admin": {
      "post": {
        "description": "Admin creation endpoint.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "any"
                  },
                  "email": {
                    "type": "string",
                    "example": "any"
                  },
                  "password": {
                    "type": "string",
                    "example": "any"
                  },
                  "role": {
                    "type": "string",
                    "example": "any"
                  },
                  "classId": {
                    "type": "string",
                    "example": "any"
                  },
                  "studentIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": "any"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Conflict"
          }
        }
      },
      "get": {
        "description": "Fetch all admins with filtering options.",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "role",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/admin/{id}": {
      "put": {
        "description": "Update admin details.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      },
      "delete": {
        "description": "Delete admin by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      },
      "get": {
        "description": "Get admin by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    },
    "/parents/communications": {
      "post": {
        "description": "Parent communication endpoint.",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/parents/grades": {
      "get": {
        "description": "Get grades for parents.",
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    },
    "/students/grades": {
      "get": {
        "description": "Get grades for students.",
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    },
    "/classes": {
      "post": {
        "description": "Create a new class.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "any"
                  },
                  "teacherId": {
                    "type": "string",
                    "example": "any"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Default response"
          }
        }
      }
    },
    "/classes/{classId}": {
      "post": {
        "description": "Add a student to a class.",
        "parameters": [
          {
            "name": "classId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "studentId": {
                    "type": "string",
                    "example": "any"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/classes/grades": {
      "post": {
        "description": "Post grades for a class.",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your bearer token in the format **Bearer <token>**"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}